# Copy to ignored .env and use uv run --env-file .env, or export variables manually.
# The CLI itself does not load .env. Never put tokens or OAuth callback URLs here.
X_CLIENT_ID=your-public-oauth2-client-id
# Find your numeric X user ID: README.md, "Find your numeric account ID".
# Keep the actual ID/username local; never commit them to this public repository.
# For --app-owner-id "$X_APP_OWNER_ID", export this in the invoking shell too:
# --env-file cannot populate a shell substitution. Or pass the numeric ID directly.
X_APP_OWNER_ID=your-verified-numeric-app-owner-id
# Only confidential clients need X_CLIENT_SECRET; use a protected runtime environment.
# X_CLIENT_SECRET=
# State defaults to ~/.local/state/x-bookmark-migrator, outside Git.
